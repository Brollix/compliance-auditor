# ====================================================================
# Configuración del Entorno - Frontend (Vite)
# ====================================================================

# Base URL para el backend (donde corre FastAPI).
# Para desarrollo local normal contra tu compu, dejá esto así o omitilo (usa 8001 por defecto).
VITE_API_URL=http://localhost:8001

# ====================================================================
# [Avanzado] Testear Frontend Local contra Backend de Producción
# ====================================================================
# Para conectarte a tu backend ya subido a AWS sin levantar Uvicorn local:
# 1. Copiá este archivo y guardalo como `.env` (sin el .example).
# 2. Reemplazá el valor de abajo con tu dominio de AWS:
# VITE_API_URL=https://tu-api-en-aws.com
