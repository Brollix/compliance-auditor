{
  "name": "complai-auditor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server/main.js",
  "scripts": {
    "dev": "vite",
    "api:prod": "cd server && .\\venv\\Scripts\\uvicorn main:app --reload --env-file .env --port 8001",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "start:frontend": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "start:all": "concurrently \"npm run api:prod\" \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
