# ============================================
# Variables de Entorno Locales (Development)
# ============================================

# Base de Vectores Remota
CHROMA_HOST=localhost # o IP de tu EC2
CHROMA_PORT=8000

# Infraestructura AWS (para pruebas locales)
S3_BUCKET=tu-bucket-local-o-dev
DYNAMO_TABLE=AuditFindings
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=tu-perfil-aws # (Opcional, si usás perfiles locales)

# NOTA: No dejar credenciales de AWS explícitas por seguridad.
