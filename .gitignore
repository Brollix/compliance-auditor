*.pem
*.key

# ========================
# Infraestructura (Terraform)
# ========================
# Directorio local de inicialización de terraform y modulos
**/.terraform/*

# Archivos de estado de terraform (PUEDEN CONTENER SECRETOS)
*.tfstate
*.tfstate.*

# Archivos de variables con secretos
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Archivos de planes (pueden contener secretos)
*tfplan*

# Overrides locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Configuración CLI
.terraformrc
terraform.rc

# ========================
# Generados / Empaquetados / DBs
# ========================
